  m_Script: {fileID: 11500000, guid: b470753b54ce932469c2c759655f968e, type: 3}
  m_Name: FamilyPhoto
  m_EditorClassIdentifier: Assembly-CSharp::CatchableItem
  itemName: Family Photo
  modelPrefab: {fileID: 6035164839299704247, guid: 40ab63d7a97005b49879e82ec7cacfe7, type: 3}
  dialogueLines:
  - 'This photo, a mom, a dad, and a kid. They look familiar for some reason. '
  - 'Like I know, or maybe knew, these people. Or I at the very least should know
    them. '
  - I need to hold onto this, take a closer, or maybe longer look at it. Something
    feels empty when I look at it. Like it was once something that I held dear, a
    piece of my home that I no... longer... remember...
